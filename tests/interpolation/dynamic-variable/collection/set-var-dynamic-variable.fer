meta {
  name: set-var-dynamic-variable
  type: http
  seq: 1
}

post {
  url:  http://localhost:8081/echo
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

script:pre-request {
  fer.setVar("title", "{{$randomFirstName}}");
}

body:json {
  {
    "title": "{{title}}"
  }
}
