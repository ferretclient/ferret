meta {
  name: nested-walkup
  type: http
  seq: 2
}

get {
  url: http://127.0.0.1:8081/ping
  body: none
  auth: none
}

script:pre-request {
  const { buildRequestId } = require('../../shared-scripts/deep/nested/nested-helper');
  fer.setVar('requestId', buildRequestId('/api/v1/users', 'POST'));
}

tests {
  test('nested shared util resolves signature-utils via walk-up', function() {
    expect(fer.getVar('requestId')).to.match(/^POST__api_v1_users_[0-9a-f]{8}$/);
  });
}
