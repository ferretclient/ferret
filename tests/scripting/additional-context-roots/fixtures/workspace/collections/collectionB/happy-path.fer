meta {
  name: happy-path
  type: http
  seq: 1
}

get {
  url: http://127.0.0.1:8081/ping
  body: none
  auth: none
}

script:pre-request {
  const { generateAuthToken } = require('../../shared-scripts/utils');
  fer.setVar('authToken', generateAuthToken({ apiKey: 'collectionB-key', timestamp: 1700000001 }));
}

tests {
  test('Collection B builds a valid auth token via the shared util', function() {
    expect(fer.getVar('authToken')).to.match(/^collectionB-key\.1700000001\.[0-9a-f]{8}$/);
  });
}
