{
  "name": "useferret",
  "private": true,
  "workspaces": [
    "packages/ferret-app",
    "packages/ferret-electron",
    "packages/ferret-cli",
    "packages/ferret-common",
    "packages/ferret-converters",
    "packages/ferret-schema",
    "packages/ferret-schema-types",
    "packages/ferret-query",
    "packages/ferret-js",
    "packages/ferret-lang",
    "packages/ferret-tests",
    "packages/ferret-toml",
    "packages/ferret-graphql-docs",
    "packages/ferret-requests",
    "packages/ferret-filestore",
    "packages/ferret-sqlite"
  ],
  "homepage": "https://ferret.io",
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@faker-js/faker": "^7.6.0",
    "@jest/globals": "^29.2.0",
    "@playwright/test": "1.62.1",
    "@rollup/plugin-json": "^6.1.0",
    "@stylistic/eslint-plugin": "^5.3.1",
    "@types/adm-zip": "^0.5.8",
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.14.1",
    "@typescript-eslint/parser": "^8.39.0",
    "adm-zip": "^0.6.0",
    "concurrently": "^8.2.2",
    "cross-env": "10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-diff": "^2.0.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fs-extra": "^11.1.1",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "jest": "^29.2.0",
    "lodash-es": "^4.17.23",
    "nano-staged": "^0.8.0",
    "playwright": "1.62.1",
    "pretty-quick": "^3.1.3",
    "randomstring": "^1.2.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.6"
  },
  "scripts": {
    "setup": "node ./scripts/setup.js",
    "test": "npm test --workspaces --if-present",
    "check": "npm run lint && npm test",
    "watch:converters": "npm run watch --workspace=packages/ferret-converters",
    "dev": "node ./scripts/dev.js",
    "watch": "npm run dev:watch",
    "dev:watch": "node ./scripts/dev-hot-reload.js",
    "dev:web": "npm run dev --workspace=packages/ferret-app",
    "build:web": "npm run build --workspace=packages/ferret-app",
    "dev:electron": "npm run dev --workspace=packages/ferret-electron",
    "dev:electron:debug": "npm run debug --workspace=packages/ferret-electron",
    "storybook": "npm run storybook --workspace=packages/ferret-app",
    "build:ferret-common": "npm run build --workspace=packages/ferret-common",
    "build:ferret-requests": "npm run build --workspace=packages/ferret-requests",
    "build:ferret-filestore": "npm run build --workspace=packages/ferret-filestore",
    "build:ferret-sqlite": "npm run build --workspace=packages/ferret-sqlite",
    "build:ferret-converters": "npm run build --workspace=packages/ferret-converters",
    "build:ferret-query": "npm run build --workspace=packages/ferret-query",
    "build:graphql-docs": "npm run build --workspace=packages/ferret-graphql-docs",
    "build:schema-types": "npm run build --workspace=packages/ferret-schema-types",
    "build:electron": "node ./scripts/build-electron.js",
    "dist": "npm run build:web && npm run build:electron",
    "version:set": "node ./scripts/set-version.js",
    "build:electron:benchmark": "cross-env FERRET_BENCHMARK=true npm run build:benchmark --workspace=packages/ferret-app && cross-env FERRET_BENCHMARK=true node scripts/build-electron.js",
    "build:electron:mac": "./scripts/build-electron.sh mac",
    "build:electron:win": "./scripts/build-electron.sh win",
    "build:electron:linux": "./scripts/build-electron.sh linux",
    "build:electron:deb": "./scripts/build-electron.sh deb",
    "build:electron:rpm": "./scripts/build-electron.sh rpm",
    "build:electron:snap": "./scripts/build-electron.sh snap",
    "watch:common": "npm run watch --workspace=packages/ferret-common",
    "watch:requests": "npm run watch --workspace=packages/ferret-requests",
    "test:codegen": "node playwright/codegen.ts",
    "test:e2e": "playwright test --project=default --project=system-pac",
    "test:e2e:ssl": "playwright test --project=ssl",
    "test:e2e:auth": "playwright test --project=auth",
    "test:e2e:mock-server": "playwright test --project=mock-server",
    "test:e2e:sanity": "playwright test --project=default --project=system-pac --grep @sanity",
    "test:benchmark": "playwright test --config=playwright.benchmark.config.ts",
    "lint": "cross-env NODE_OPTIONS=\"--max_old_space_size=4096\" npx eslint",
    "lint:fix": "cross-env NODE_OPTIONS=\"--max_old_space_size=4096\" npx eslint --fix",
    "prepare": "husky"
  },
  "nano-staged": {
    "*.{js,ts,jsx}": [
      "npm run lint:fix"
    ]
  },
  "overrides": {
    "axios": "1.18.0",
    "tar": "7.5.22",
    "app-builder-lib": {
      "tar": "7.5.22"
    },
    "brace-expansion@5": "5.0.9",
    "minimatch@10": {
      "brace-expansion": "5.0.9"
    },
    "rollup": "3.30.0",
    "pbkdf2": "3.1.5",
    "electron-store": {
      "conf": {
        "json-schema-typed": "8.0.1"
      }
    }
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "git-url-parse": "^14.1.0"
  }
}