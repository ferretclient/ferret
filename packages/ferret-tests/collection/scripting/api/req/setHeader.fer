meta {
  name: setHeader
  type: http
  seq: 6
}

get {
  url: {{host}}/ping
  body: none
  auth: none
}

headers {
  ferret: is-awesome
}


assert {
  res.status: eq 200
  res.body: eq pong
}

script:pre-request {
  req.setHeader('ferret', 'is-the-future');
}

tests {
  test("req.setHeader(name)", function() {
    const h = req.getHeader('ferret');
    expect(h).to.equal("is-the-future");
  });
}