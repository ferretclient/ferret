meta {
  name: getHeader
  type: http
  seq: 5
}

get {
  url: {{host}}/ping
  body: none
  auth: none
}

headers {
  ferret: is-awesome
}


assert {
  res.status: eq 200
  res.body: eq pong
}

tests {
  test("req.getHeader(name)", function() {
    const h = req.getHeader('ferret');
    expect(h).to.equal("is-awesome");
  });
}