meta {
  name: directGet
  type: http
  seq: 10
}

get {
  url: {{localhost}}/ping
  body: none
  auth: inherit
}

script:pre-request {
  const jar = fer.cookies.jar()

  const host = fer.getEnvVar('localhost');
  await jar.setCookie(host, {
    key: 'session',
    value: 'abc123',
    path: '/'
  });
}

tests {
  test("get() should return value for existing cookie", function() {
    expect(fer.cookies.get('session')).to.equal('abc123');
  });

  test("get() should return undefined for nonexistent cookie", function() {
    expect(fer.cookies.get('nonexistent')).to.be.undefined;
  });

  test("has() should return true for existing cookie", function() {
    expect(fer.cookies.has('session')).to.be.true;
  });

  test("has() should return false for nonexistent cookie", function() {
    expect(fer.cookies.has('nonexistent')).to.be.false;
  });

  test("has() with value should return true when value matches", function() {
    expect(fer.cookies.has('session', 'abc123')).to.be.true;
  });

  test("has() with value should return false when value does not match", function() {
    expect(fer.cookies.has('session', 'wrong')).to.be.false;
  });

  const jar = fer.cookies.jar()
  await jar.clear()
}

settings {
  encodeUrl: true
}
