meta {
  name: get-url-string
  type: http
  seq: 1
}

post {
  url: https://echo.ferret.io
  body: none
  auth: inherit
}

tests {
  await test("send request with a get url string", async () => {
    const res = await fer.sendRequest("https://testbench-sanity.ferret.io/ping");
    expect(res.data).to.eql('pong');
  });
}
