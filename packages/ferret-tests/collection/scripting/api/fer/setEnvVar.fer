meta {
  name: setEnvVar
  type: http
  seq: 3
}

get {
  url: {{host}}/ping
  body: none
  auth: none
}


script:post-response {
  fer.setEnvVar("testSetEnvVar", "ferret-29653")
}

tests {
  test("should set env var in scripts", function() {
    const testSetEnvVar = fer.getEnvVar("testSetEnvVar")
    expect(testSetEnvVar).to.equal("ferret-29653");
  });
}