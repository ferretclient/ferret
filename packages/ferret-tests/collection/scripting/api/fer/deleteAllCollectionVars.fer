meta {
  name: deleteAllCollectionVars
  type: http
  seq: 28
}

get {
  url: {{host}}/ping
  body: none
  auth: none
}

script:pre-request {
  fer.setCollectionVar("testDelAllCollectionA", "a");
  fer.setCollectionVar("testDelAllCollectionB", "b");
}

tests {
  const savedCollectionVars = fer.getAllCollectionVars();
  fer.deleteAllCollectionVars();

  test("should delete all collection vars", function() {
    const valA = fer.getCollectionVar("testDelAllCollectionA");
    const valB = fer.getCollectionVar("testDelAllCollectionB");
    expect(valA).to.be.undefined;
    expect(valB).to.be.undefined;
  });

  test("should not throw when called on empty scope", function() {
    expect(function() {
      fer.deleteAllCollectionVars();
    }).to.not.throw();
  });

  // Restore collection vars for subsequent requests
  for (const [key, value] of Object.entries(savedCollectionVars)) {
    fer.setCollectionVar(key, value);
  }
}
