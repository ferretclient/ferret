meta {
  name: setVar
  type: http
  seq: 4
}

get {
  url: {{host}}/ping
  body: none
  auth: none
}

script:post-response {
  fer.setVar("testSetVar", "ferret-test-87267")
}

tests {
  test("should get var in scripts", function() {
    const testSetVar = fer.getVar("testSetVar");
    expect(testSetVar).to.equal("ferret-test-87267");
  });
}
