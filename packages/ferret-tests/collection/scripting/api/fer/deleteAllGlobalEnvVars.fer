meta {
  name: deleteAllGlobalEnvVars
  type: http
  seq: 21
}

get {
  url: {{host}}/ping
  body: none
  auth: none
}

script:pre-request {
  fer.setGlobalEnvVar("testDelAllGlobalA", "a");
  fer.setGlobalEnvVar("testDelAllGlobalB", "b");
}

tests {
  const savedGlobalEnvVars = fer.getAllGlobalEnvVars();
  fer.deleteAllGlobalEnvVars();

  test("should delete all global env vars", function() {
    const valA = fer.getGlobalEnvVar("testDelAllGlobalA");
    const valB = fer.getGlobalEnvVar("testDelAllGlobalB");
    expect(valA).to.be.undefined;
    expect(valB).to.be.undefined;
  });

  test("should not throw when called on empty scope", function() {
    expect(function() {
      fer.deleteAllGlobalEnvVars();
    }).to.not.throw();
  });

  // Restore global env vars for subsequent requests
  for (const [key, value] of Object.entries(savedGlobalEnvVars)) {
    fer.setGlobalEnvVar(key, value);
  }
}
