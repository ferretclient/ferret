meta {
  name: data types
  type: http
  seq: 2
}

post {
  url: {{host}}/api/echo/json
  body: json
  auth: none
}

body:json {
  {
    "boolean": false,
    "number": 1,
    "string": "ferret",
    "array": [1, 2, 3, 4, 5],
    "object": {
      "hello": "ferret"
    },
    "null": null
  }
}

script:pre-request {
  const reqBody = req.getBody();
  
  fer.setVar("dataTypeVarTest", {
    ...reqBody,
    "undefined": undefined
  });
}

tests {
  test("data types check via fer var", function() {
    let v = fer.getVar("dataTypeVarTest");
    v = {
      ...v,
      "undefined": undefined
    };
    expect(v).to.eql({
      "boolean": false,
      "number": 1,
      "string": "ferret",
      "array": [1, 2, 3, 4, 5],
      "object": {
        "hello": "ferret"
      },
      "null": null,
      "undefined": undefined
    })
  });
}
