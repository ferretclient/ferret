meta {
  name: nanoid
  type: http
  seq: 1
}

get {
  url: {{host}}/ping
  body: none
  auth: none
}

script:pre-request {
  const { nanoid } = require("nanoid");
   
  fer.setVar("nanoid-test-id", nanoid());
}

tests {
  test("nanoid var", function() {
    const id = fer.getVar('nanoid-test-id');
    let isValidNanoid = /^[a-zA-Z0-9_-]{21}$/.test(id)
    fer.setVar('nanoid-test-id', null);
    expect(isValidNanoid).to.eql(true);
  });
}
