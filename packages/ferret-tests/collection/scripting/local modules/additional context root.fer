meta {
  name: additional context root
  type: http
  seq: 4
}

post {
  url: {{host}}/api/echo/json
  body: json
  auth: none
}

body:json {
  {
    "test": "additionalContextRoot"
  }
}

assert {
  res.status: eq 200
}

script:pre-request {
  // Load module from additionalContextRoot using relative path
  // This tests that modules outside the collection can be loaded when configured in ferret.json
  // The path "../additional-context-root-lib" is allowed because it's listed in additionalContextRoots
  const additionalLib = require('../additional-context-root-lib');

  // Verify all dependencies loaded correctly
  const deps = additionalLib.verifyDependencies();
  fer.setVar('fakerLoaded', deps.fakerLoaded);
  fer.setVar('localModuleLoaded', deps.localModuleLoaded);

  // Test the utility functions
  const user = additionalLib.generateUser();
  fer.setVar('hasFirstName', typeof user.firstName === 'string' && user.firstName.length > 0);
  fer.setVar('hasLastName', typeof user.lastName === 'string' && user.lastName.length > 0);
  fer.setVar('hasFullName', typeof user.fullName === 'string' && user.fullName.includes(' '));
  fer.setVar('hasGreeting', typeof user.greeting === 'string' && user.greeting.startsWith('Hello, '));
  fer.setVar('hasEmail', typeof user.email === 'string' && user.email.includes('@'));

  // Test direct functions from local module
  const formatted = additionalLib.formatName('John', 'Doe');
  fer.setVar('formatNameResult', formatted);

  const greeting = additionalLib.generateGreeting('Ferret');
  fer.setVar('greetingResult', greeting);

  // Test direct require of a specific file from additionalContextRoot
  const libDirect = require('../additional-context-root-lib/lib.js');
  fer.setVar('directRequireWorks', typeof libDirect.formatName === 'function');
  fer.setVar('directFormatName', libDirect.formatName('Direct', 'Test'));
  fer.setVar('directGreeting', libDirect.generateGreeting('World'));
}

tests {
  test("should load module from additionalContextRoot", function() {
    expect(fer.getVar('fakerLoaded')).to.equal(true);
    expect(fer.getVar('localModuleLoaded')).to.equal(true);
  });

  test("should resolve npm module (@faker-js/faker) from collection node_modules", function() {
    expect(fer.getVar('hasFirstName')).to.equal(true);
    expect(fer.getVar('hasLastName')).to.equal(true);
    expect(fer.getVar('hasEmail')).to.equal(true);
  });

  test("should resolve local module (./lib.js) relative to additionalContextRoot", function() {
    expect(fer.getVar('hasFullName')).to.equal(true);
    expect(fer.getVar('hasGreeting')).to.equal(true);
  });

  test("should correctly execute local module functions", function() {
    expect(fer.getVar('formatNameResult')).to.equal('John Doe');
    expect(fer.getVar('greetingResult')).to.equal('Hello, Ferret!');
  });

  test("should directly require specific file from additionalContextRoot", function() {
    expect(fer.getVar('directRequireWorks')).to.equal(true);
    expect(fer.getVar('directFormatName')).to.equal('Direct Test');
    expect(fer.getVar('directGreeting')).to.equal('Hello, World!');
  });
}
