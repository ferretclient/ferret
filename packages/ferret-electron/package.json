{
  "version": "0.2.0",
  "name": "ferret",
  "license": "MIT",
  "description": "Opensource API Client for Exploring and Testing APIs",
  "homepage": "https://github.com/ferretclient/ferret",
  "repository": {
    "type": "git",
    "url": "https://github.com/ferretclient/ferret.git"
  },
  "private": true,
  "main": "src/index.js",
  "author": "Ferret",
  "scripts": {
    "clean": "rimraf dist",
    "dev": "electron .",
    "debug": "electron . --inspect=9229",
    "dist:mac": "electron-builder --mac --config electron-builder-config.js --publish never",
    "dist:win": "electron-builder --win --config electron-builder-config.js --publish never",
    "dist:linux": "electron-builder --linux AppImage --config electron-builder-config.js --publish never",
    "dist:deb": "electron-builder --linux deb --config electron-builder-config.js --publish never",
    "dist:rpm": "electron-builder --linux rpm --config electron-builder-config.js --publish never",
    "dist:snap": "electron-builder --linux snap --config electron-builder-config.js --publish never",
    "pack": "electron-builder --dir",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --experimental-sqlite\" jest",
    "test:ci": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js"
  },
  "jest": {
    "modulePaths": [
      "node_modules"
    ]
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "14.2.1",
    "@aws-sdk/credential-providers": "3.1019.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.7.13",
    "@lydell/node-pty": "^1.1.0",
    "@ferretclient/common": "0.2.0",
    "@ferretclient/converters": "^0.2.0",
    "@ferretclient/filestore": "^0.2.0",
    "@ferretclient/js": "0.2.0",
    "@ferretclient/lang": "0.2.0",
    "@ferretclient/requests": "^0.2.0",
    "@ferretclient/schema": "0.2.0",
    "@ferretclient/sqlite": "0.2.0",
    "about-window": "^1.15.2",
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "aws4-axios": "^3.3.15",
    "axios": "1.18.0",
    "axios-ntlm": "^1.4.2",
    "chai": "^4.3.7",
    "chokidar": "^3.5.3",
    "content-disposition": "^0.5.4",
    "cors": "^2.8.5",
    "decomment": "^0.9.5",
    "diff": "^8.0.3",
    "dotenv": "^16.0.3",
    "electron-is-dev": "^2.0.0",
    "electron-notarize": "^1.2.2",
    "electron-store": "^8.1.0",
    "electron-util": "^0.17.2",
    "express": "^4.21.2",
    "extract-zip": "^2.0.1",
    "form-data": "4.0.4",
    "fs-extra": "^10.1.0",
    "graphql": "^16.6.0",
    "hexy": "^0.3.5",
    "http-proxy-agent": "^7.0.0",
    "https-proxy-agent": "^7.0.2",
    "iconv-lite": "^0.6.3",
    "is-valid-path": "^0.1.1",
    "js-yaml": "4.3.1",
    "lodash": "4.18.1",
    "mime-types": "^2.1.35",
    "nanoid": "3.3.18",
    "native-reg": "^1.1.1",
    "qs": "^6.15.2",
    "simple-git": "4.0.2",
    "socks-proxy-agent": "^8.0.2",
    "tough-cookie": "^6.0.0",
    "uuid": "^10.0.0",
    "workerpool": "10.0.2",
    "yup": "^0.32.11"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "devDependencies": {
    "electron": "~37.6.1",
    "electron-builder": "^24.13.3",
    "electron-devtools-installer": "^4.0.0"
  }
}
